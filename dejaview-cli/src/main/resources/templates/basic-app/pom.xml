<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>__GROUP_ID__</groupId>
    <artifactId>__ARTIFACT_ID__</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>__NAME__</name>
    <description>A DejaView application.</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <teavm.version>__TEAVM_VERSION__</teavm.version>
        <dejaview.version>__DEJAVIEW_VERSION__</dejaview.version>

        <!-- Production pipeline: `-Pproduction` flips these to optimized settings. -->
        <dejaview.compiler.profile>development</dejaview.compiler.profile>
        <dejaview.compiler.optimization-level>SIMPLE</dejaview.compiler.optimization-level>
        <dejaview.compiler.minify>false</dejaview.compiler.minify>
        <dejaview.compiler.source-maps>true</dejaview.compiler.source-maps>
        <dejaview.compiler.size-budget-bytes>2097152</dejaview.compiler.size-budget-bytes>

        <!-- Reproducible archive output across equivalent builds. -->
        <project.build.outputTimestamp>2026-11-13T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.dejaview</groupId>
            <artifactId>dejaview-reactivity</artifactId>
            <version>${dejaview.version}</version>
        </dependency>
        <dependency>
            <groupId>io.dejaview</groupId>
            <artifactId>dejaview-dom</artifactId>
            <version>${dejaview.version}</version>
        </dependency>

        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-classlib</artifactId>
            <version>${teavm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-jso-apis</artifactId>
            <version>${teavm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.dejaview</groupId>
            <artifactId>dejaview-compiler</artifactId>
            <version>${dejaview.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>copy-webapp</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/webapp</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/webapp</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.teavm</groupId>
                <artifactId>teavm-maven-plugin</artifactId>
                <version>${teavm.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.teavm</groupId>
                        <artifactId>teavm-classlib</artifactId>
                        <version>${teavm.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>compile-to-javascript</id>
                        <phase>package</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <mainClass>__PACKAGE__.App</mainClass>
                            <targetType>JAVASCRIPT</targetType>
                            <targetDirectory>${project.build.directory}/webapp</targetDirectory>
                            <targetFileName>app.js</targetFileName>
                            <jsModuleType>NONE</jsModuleType>
                            <optimizationLevel>${dejaview.compiler.optimization-level}</optimizationLevel>
                            <minifying>${dejaview.compiler.minify}</minifying>
                            <sourceMapsGenerated>${dejaview.compiler.source-maps}</sourceMapsGenerated>
                            <strict>true</strict>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>verify-webapp</id>
                        <!-- The CLI builds with `package`, so validation is bound there. -->
                        <phase>package</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>io.dejaview.compiler.VerifyWebApp</mainClass>
                            <arguments>
                                <argument>--webapp</argument>
                                <argument>${project.build.directory}/webapp</argument>
                                <argument>--budget-bytes</argument>
                                <argument>${dejaview.compiler.size-budget-bytes}</argument>
                            </arguments>
                            <classpathScope>compile</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
          Production pipeline: aggressive dead-code elimination (FULL), minification,
          source maps retained for field diagnostics. Use: ./mvnw clean package -Pproduction
        -->
        <profile>
            <id>production</id>
            <properties>
                <dejaview.compiler.profile>production</dejaview.compiler.profile>
                <dejaview.compiler.optimization-level>FULL</dejaview.compiler.optimization-level>
                <dejaview.compiler.minify>true</dejaview.compiler.minify>
                <dejaview.compiler.source-maps>true</dejaview.compiler.source-maps>
                <dejaview.compiler.size-budget-bytes>786432</dejaview.compiler.size-budget-bytes>
            </properties>
        </profile>
    </profiles>
</project>
