<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.dejaview</groupId>
    <artifactId>dejaview-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>DejaView</name>
    <description>Java-first frontend framework compiled to JavaScript.</description>
    <url>https://github.com/dejaview/dejaview</url>

    <modules>
        <module>dejaview-core</module>
        <module>dejaview-reactivity</module>
        <module>dejaview-dom</module>
        <module>dejaview-di</module>
        <module>dejaview-router</module>
        <module>dejaview-http</module>
        <module>dejaview-forms</module>
        <module>dejaview-state</module>
        <module>dejaview-server</module>
        <module>dejaview-ssr</module>
        <module>dejaview-ssg</module>
        <module>dejaview-compiler</module>
        <module>dejaview-cli</module>
        <module>examples/counter</module>
        <module>examples/showcase</module>
        <module>examples/website</module>
        <module>examples/ssr</module>
        <module>examples/ssg</module>
    </modules>

    <properties>
        <!--
          DejaView requires JDK 25 to build. Browser-compiled modules use the same
          release level; TeaVM 0.16.0 was validated against Java 25 class files
          (major version 69). See docs/COMPILER.md.
        -->
        <maven.compiler.release>25</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <teavm.version>0.16.0</teavm.version>
        <junit.version>5.14.4</junit.version>
        <playwright.version>1.64.0</playwright.version>

        <!--
          Production pipeline configuration. The `production` profile (below)
          flips these to the optimized TeaVM settings; the development build
          keeps SIMPLE optimization and human-readable output.
        -->
        <dejaview.compiler.profile>development</dejaview.compiler.profile>
        <dejaview.compiler.optimization-level>SIMPLE</dejaview.compiler.optimization-level>
        <dejaview.compiler.minify>false</dejaview.compiler.minify>
        <dejaview.compiler.source-maps>true</dejaview.compiler.source-maps>
        <dejaview.compiler.size-budget-bytes>2097152</dejaview.compiler.size-budget-bytes>

        <!-- Reproducible archive output across equivalent builds. -->
        <project.build.outputTimestamp>2026-11-13T00:00:00Z</project.build.outputTimestamp>

        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.1</maven-failsafe-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
        <exec-maven-plugin.version>3.7.0</exec-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.dejaview</groupId>
                <artifactId>dejaview-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.dejaview</groupId>
                <artifactId>dejaview-reactivity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.dejaview</groupId>
                <artifactId>dejaview-dom</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.dejaview</groupId>
                <artifactId>dejaview-di</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.dejaview</groupId>
                <artifactId>dejaview-router</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.dejaview</groupId>
                <artifactId>dejaview-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.dejaview</groupId>
                <artifactId>dejaview-forms</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.dejaview</groupId>
                <artifactId>dejaview-state</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.dejaview</groupId>
                <artifactId>dejaview-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.dejaview</groupId>
                <artifactId>dejaview-ssr</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.dejaview</groupId>
                <artifactId>dejaview-ssg</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.dejaview</groupId>
                <artifactId>dejaview-compiler</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.dejaview</groupId>
                <artifactId>dejaview-cli</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.teavm</groupId>
                <artifactId>teavm-classlib</artifactId>
                <version>${teavm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.teavm</groupId>
                <artifactId>teavm-jso-apis</artifactId>
                <version>${teavm.version}</version>
            </dependency>

            <dependency>
                <groupId>com.microsoft.playwright</groupId>
                <artifactId>playwright</artifactId>
                <version>${playwright.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>${maven.compiler.parameters}</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                    <!--
                      Shared by the browser modules: copy src/main/webapp into
                      the TeaVM output directory before the bundle is compiled.
                    -->
                    <executions>
                        <execution>
                            <id>copy-webapp</id>
                            <phase>prepare-package</phase>
                            <goals>
                                <goal>copy-resources</goal>
                            </goals>
                            <configuration>
                                <outputDirectory>${project.build.directory}/webapp</outputDirectory>
                                <resources>
                                    <resource>
                                        <directory>src/main/webapp</directory>
                                    </resource>
                                </resources>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.teavm</groupId>
                    <artifactId>teavm-maven-plugin</artifactId>
                    <version>${teavm.version}</version>
                    <!--
                      TeaVM 0.16.0 no longer bundles the class library through the
                      plugin by default. Browser modules also declare teavm-classlib
                      as a provided dependency, which TeaVM requires on the project
                      class path. See docs/COMPILER.md.

                      The plugin is configured once here so every browser module
                      compiles through the same pipeline: modules only set
                      `mainClass`. The `production` profile activates the optimized
                      settings (FULL dead-code elimination, minification); the
                      development build stays debuggable.
                    -->
                    <dependencies>
                        <dependency>
                            <groupId>org.teavm</groupId>
                            <artifactId>teavm-classlib</artifactId>
                            <version>${teavm.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <targetType>JAVASCRIPT</targetType>
                        <targetDirectory>${project.build.directory}/webapp</targetDirectory>
                        <targetFileName>app.js</targetFileName>
                        <jsModuleType>NONE</jsModuleType>
                        <optimizationLevel>${dejaview.compiler.optimization-level}</optimizationLevel>
                        <!-- TeaVM's parameter is `minifying` (property teavm.minifying, default true);
                             the legacy `<minified>` element was silently ignored. -->
                        <minifying>${dejaview.compiler.minify}</minifying>
                        <sourceMapsGenerated>${dejaview.compiler.source-maps}</sourceMapsGenerated>
                        <strict>true</strict>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>DejaView requires JDK 25 or newer.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                    <message>DejaView requires Maven 3.9.0 or newer.</message>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Production pipeline: aggressive dead-code elimination (FULL),
          minification, source maps retained for field diagnostics, and a tight
          output-size tripwire (768 KiB). The output is browser-equivalent to
          the development build; only the emitted JavaScript differs.
          Use: ./mvnw clean package -Pproduction
        -->
        <profile>
            <id>production</id>
            <properties>
                <dejaview.compiler.profile>production</dejaview.compiler.profile>
                <dejaview.compiler.optimization-level>FULL</dejaview.compiler.optimization-level>
                <dejaview.compiler.minify>true</dejaview.compiler.minify>
                <dejaview.compiler.source-maps>true</dejaview.compiler.source-maps>
                <dejaview.compiler.size-budget-bytes>786432</dejaview.compiler.size-budget-bytes>
            </properties>
        </profile>
    </profiles>
</project>
